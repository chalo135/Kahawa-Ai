# TEMPLATE ONLY — no real secrets here. On the server, copy this to
# .env.production and fill in the real values:
#     cp .env.example .env.production && nano .env.production
# .env.production is git-ignored and must NEVER be committed or shared.

# --- Groq (AI advisor chat) ---
GROQ_API_KEY=your_real_groq_key_here

# --- Session signing key ---
# Generate a strong one on the server with:  openssl rand -base64 48
JWT_SECRET=paste_a_long_random_48+_char_string_here

# --- HTTPS / cookies ---
# true because Caddy serves the API over HTTPS. Keep true in production.
COOKIE_SECURE=true

# The app runs behind Caddy (a reverse proxy), so read the real client IP from
# X-Forwarded-For for correct per-user rate limiting.
TRUST_PROXY=true

# Comma-separated list of the exact origin(s) your frontend is served from.
# e.g. https://kahawa.netlify.app  (no trailing slash)
ALLOWED_ORIGINS=https://your-frontend-domain

# --- Groq models (defaults shown; safe to leave as-is) ---
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# --- Rate limits (requests per minute per client IP) ---
CHAT_RATE_LIMIT_PER_MIN=10
PREDICT_RATE_LIMIT_PER_MIN=20

# --- Model path (default works; the file is baked into the image at /app) ---
MODEL_PATH=coffee_rust_model.h5
